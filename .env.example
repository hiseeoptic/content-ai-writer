# =====================================================================
# Vinalink Group AI MassWriter — Environment variables
# Copy this file to ".env.local" for local development.
# Add the same keys in Vercel Dashboard → Project → Settings → Environment Variables
# for production / preview deployments.
# =====================================================================

# ---------- REQUIRED ----------

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- OPTIONAL (defaults shown) ----------

# Text model. gpt-4o-mini is fast & cheap, gpt-4o is higher quality.
OPENAI_TEXT_MODEL=gpt-4o-mini

# Image model. gpt-image-1 supports reference images via images.edit.
OPENAI_IMAGE_MODEL=gpt-image-1

# OpenAI organization ID (only needed if you belong to multiple orgs).
# OPENAI_ORG_ID=org-xxxxxxxxxxxx

# ---------- DATABASE (optional but recommended) ----------
# Vercel Postgres connection. After creating a Postgres DB in Vercel
# Dashboard → Storage → Create → Postgres, the following env vars are
# auto-injected when you "Connect" the database to this project.
# If unset, the app falls back to local IndexedDB / localStorage.

# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
